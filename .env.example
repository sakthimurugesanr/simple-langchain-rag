# Copy this to .env. Keep values private; .gitignore excludes the real file.
LLM_PROVIDER=openrouter
# Leave empty until you choose an exact current ID with --list-models.
LLM_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ollama must already be running, with your chosen model downloaded.
OLLAMA_BASE_URL=http://localhost:11434
# Two retries means at most three attempts per selected model.
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# These are separate from chat settings. Actual embedding execution arrives in Step 2.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
